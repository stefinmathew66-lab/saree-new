# Velnora Studio - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# Do NOT commit '.env' to your public git repository.

# Razorpay Configuration
# Obtain your public Key ID from Razorpay Dashboard > Settings > API Keys
# Example (Live mode): rzp_live_xxxxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID_HERE

# Backend Configuration (Optional)
# If left blank, the app will run in client-side direct payment integration mode (best for static builds).
# If set, the client will call the backend to create orders and verify payments securely.
# Example: http://localhost:5000
VITE_BACKEND_URL=

# Secret keys used by the backend Express server (never exposed to frontend)
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
